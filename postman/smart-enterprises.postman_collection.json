          }
        },
        {
          "name": "List Dealers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/employees/dealers/get?page=1&limit=10&status=active&includeDealers=true&scope=ASSIGNED_ONLY",
              "host": ["{{base_url}}"],
