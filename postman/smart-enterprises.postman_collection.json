    {
      "name": "Analytics",
      "description": "SUPER_ADMIN / ADMIN / MANAGER only. Other roles get 403.",
      "item": [
        {
          "name": "Summary",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/analytics/summary?from={{from}}&to={{to}}",
              "host": ["{{base_url}}"], "path": ["analytics", "summary"],
              "query": [
                { "key": "from", "value": "{{from}}" },
                { "key": "to", "value": "{{to}}" },
                { "key": "dealer_id", "value": "{{dealer_id}}", "disabled": true },
                { "key": "salesman_id", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Sales Trend",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/analytics/sales-trend?from={{from}}&to={{to}}&interval=day",
              "host": ["{{base_url}}"], "path": ["analytics", "sales-trend"],
              "query": [
                { "key": "from", "value": "{{from}}" },
                { "key": "to", "value": "{{to}}" },
                { "key": "interval", "value": "day", "description": "day | week | month" }
