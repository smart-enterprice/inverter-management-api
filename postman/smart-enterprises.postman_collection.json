{
  "info": {
    "name": "Smart Enterprises API — Full Backend",
    "description": "Complete Postman collection covering every route in the inverter-management-api.\n\nQuick start:\n1. Import this file into Postman.\n2. Run **Auth → Sign In** first. The token is auto-saved to the collection variable `{{token}}` and used by every other request.\n3. Switch environments by editing the `base_url` collection variable: local (`http://localhost:1280/api/v1`) or prod (`https://api.smartenterprises.online/api/v1`).\n\nNotes:\n• Every protected route uses Bearer auth via `{{token}}` — set once, used everywhere.\n• Create / Update bodies show example payloads. Edit them to your data before sending.\n• Path params (`:employeeId`, `:orderNumber`, etc.) are filled with the placeholders that match the saved collection variables (`{{employee_id}}`, `{{order_number}}`, `{{product_id}}`). The Sign In script also saves the logged-in user's `employee_id`.\n• Disabled (greyed-out) query params show options that exist but you may not need by default.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "smart-enterprises-full"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:1280/api/v1", "description": "Local: http://localhost:1280/api/v1 · Prod: https://api.smartenterprises.online/api/v1" },
    { "key": "token", "value": "", "description": "Auto-set by Sign In" },
    { "key": "employee_id", "value": "", "description": "Auto-set by Sign In to the logged-in user's id" },
    { "key": "order_number", "value": "", "description": "Fill in to use across the Orders folder" },
    { "key": "order_details_id", "value": "", "description": "OrderDetails number for detail-status PUT" },
    { "key": "product_id", "value": "", "description": "Used across Products folder" },
    { "key": "brand_id", "value": "", "description": "Used by brand endpoints" },
    { "key": "dealer_id", "value": "", "description": "Used as query param for analytics filtering" },
    { "key": "from", "value": "2026-05-01", "description": "Default range start" },
    { "key": "to", "value": "2026-05-31", "description": "Default range end" }
  ],
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign In (run this first)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login returns 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "if (body?.data?.token) {",
                  "    pm.collectionVariables.set('token', body.data.token);",
                  "    console.log('✓ token saved');",
                  "}",
                  "if (body?.data?.employee?.employee_id) {",
                  "    pm.collectionVariables.set('employee_id', body.data.employee.employee_id);",
                  "    console.log('✓ employee_id saved:', body.data.employee.employee_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"employee_email\": \"superadmin123@gmail.com\",\n  \"password\": \"superadmin@123\"\n}" },
            "url": { "raw": "{{base_url}}/auth/signin", "host": ["{{base_url}}"], "path": ["auth", "signin"] }
          }
        },
        {
          "name": "Check Token Active",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/auth/token/active", "host": ["{{base_url}}"], "path": ["auth", "token", "active"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/auth/logout", "host": ["{{base_url}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
    {
